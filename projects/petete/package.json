{
  "name": "petete",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-demo.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "worker:dev": "wrangler dev --local --config wrangler.local.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "db:migrate:local": "wrangler d1 migrations apply petete --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply petete --remote",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs"
  },
  "dependencies": {
    "linkedom": "^0.18.14",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
