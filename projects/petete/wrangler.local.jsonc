{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "petete-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist/petete", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "petete", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "vars": {"MAX_SESSIONS": "3"}
}
