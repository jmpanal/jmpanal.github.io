{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "petete",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {"pattern": "www.jmpanal.com/petete", "zone_name": "jmpanal.com"},
    {"pattern": "www.jmpanal.com/petete/*", "zone_name": "jmpanal.com"}
  ],
  "assets": {"directory": "./dist/petete", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "petete", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "ai": {"binding": "AI"},
  "vectorize": [{"binding": "VECTORIZE", "index_name": "petete-bge-m3"}],
  "vars": {"APP_ORIGIN": "https://www.jmpanal.com", "MAX_SESSIONS": "3"},
  "triggers": {"crons": ["*/5 * * * *", "0 4 1 * *"]},
  "observability": {"enabled": true}
}
